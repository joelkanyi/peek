<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.joelkanyi.peek</id>
    <name>Peek</name>
    <vendor url="https://github.com/joelkanyi">joelkanyi</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.PeekBundle</resource-bundle>

    <extensionPoints>
        <!-- How Peek reaches devices. The ddmlib provider registers in P1; the
             adb-CLI fallback in P2; the socket agent later. -->
        <extensionPoint
            name="transportProvider"
            interface="io.github.joelkanyi.peek.plugin.transport.TransportProvider"
            dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Peek"
            anchor="bottom"
            icon="AllIcons.Toolwindows.ToolWindowInspection"
            factoryClass="io.github.joelkanyi.peek.plugin.ui.PeekToolWindowFactory"/>
    </extensions>
</idea-plugin>
